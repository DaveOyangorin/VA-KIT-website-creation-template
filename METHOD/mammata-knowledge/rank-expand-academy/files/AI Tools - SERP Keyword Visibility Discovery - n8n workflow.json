    {
      "parameters": {
        "jsCode": "// =========================================\n// 🧮 SERP Opportunity Scoring System (Code2)\n// =========================================\n\n// --- Get keyword metrics from 'Get First 50 Keywords' ---\nconst keywordData = $('Get First 50 Keywords').item; // gets current keyword loop’s data\nconst keyword = keywordData.json.keyword || \"N/A\";\nconst sv = Number(keywordData.json.search_volume) || 0;\nconst trend = Number(keywordData.json.yearly_search_volume_trend) || 0;\nconst competitionLevel = String(keywordData.json.competition_level || \"\").toUpperCase();\n\n// --- SERP blockers info from current item (Parse SERP Features path) ---\nconst hasBlocker = \n  String($json[\"Has Map/Paid Results Above the Fold?\"]).toLowerCase() === \"yes\";\n\n// =========================================\n// 📊 SCORING LOGIC\n// =========================================\nlet score = 0;\n\n// Search Volume scoring\nif (sv > 1000) score += 2;\nelse if (sv >= 200) score += 1;\n\n// SERP Blockers scoring\nif (hasBlocker) score -= 2;\n\n// Trend scoring (no fallback version)\nif (trend > 50) score += 2;\nelse if (trend > 10) score += 1;\nelse if (trend < -10) score -= 1;\nelse if (trend < -50) score -= 2;\n\n// Competition Level\nif (competitionLevel === \"LOW\") score += 2;\nelse if (competitionLevel === \"MEDIUM\") score += 1;\nelse if (competitionLevel === \"HIGH\") score -= 1;\n\n// =========================================\n// 🏁 LABEL\n// =========================================\nlet label = \"🔴 Low Opportunity\";\nif (score >= 4) label = \"🟢 High Opportunity\";\nelse if (score >= 1) label = \"🟡 Medium Opportunity\";\n\n// --- Pull Location & Sheet ID from earlier nodes ---\nconst location =\n  $('Retrieve User Input').first().json[\"Location (check [Reference] List of Location & Language)\"] ||  \"N/A\";\n\nconst sheetId =\n  $('Set Sheet ID').first().json.id_sheet || \"N/A\";\n\n// =========================================\n// ✅ RETURN ALL DATA (merge both paths)\n// =========================================\nreturn {\n  ...$json, // keep SERP details from current loop\n  ...keywordData.json, // merge keyword metrics\n  Location: location,      // from Retrieve User Input\n  Sheet_ID: sheetId,       // from Set Sheet ID\n  \"Opportunity Score\": score,\n  \"Opportunity Label\": label\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2144,
        592
      ],
