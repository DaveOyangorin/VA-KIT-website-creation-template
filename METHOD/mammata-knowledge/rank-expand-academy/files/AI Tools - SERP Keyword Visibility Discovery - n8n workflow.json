      "id": "3a1e760c-4a7e-4867-8d99-6122169eeb66",
      "name": "Sort By Search Volume"
    },
    {
      "parameters": {
        "jsCode": "// =========================================\n// CONFIGURATION\n// =========================================\nconst Y_THRESHOLD = 1080; // Anything >=1080 requires scrolling\nconst BLOCKERS = ['local_pack', 'map', 'paid', 'hotels_pack']; // SERP types considered blockers\n\n// =========================================\n// MAIN LOGIC\n// =========================================\nconst results = $input.all().map(item => {\n  const result = item.json.tasks?.[0]?.result?.[0];\n  if (!result) return { ...item.json, error: \"No result data found\" };\n\n  const keyword = result.keyword;\n  const serpItems = result.items || [];\n\n  // =========================================\n  // 1️⃣ Build grouped diagnostic summary\n  // =========================================\n  const serpSummary = serpItems\n    .map((i, idx) => {\n      const y = i.rectangle?.y ?? 'N/A';\n      const height = i.rectangle?.height ?? 'N/A';\n      const bottomEdge =\n        typeof y === 'number' && typeof height === 'number'\n          ? y + height\n          : 'N/A';\n\n      // Determine visibility zone\n      let visibility = 'Unknown';\n      if (typeof y === 'number' && typeof height === 'number') {\n        if (bottomEdge <= Y_THRESHOLD) visibility = 'Fully Above Fold';\n        else if (y < Y_THRESHOLD && bottomEdge > Y_THRESHOLD)\n          visibility = 'Partially Visible';\n        else if (y >= Y_THRESHOLD) visibility = 'Below Fold';\n      }\n\n      return `${idx + 1}. Type: ${i.type}, Rank Group: ${i.rank_group}, Rank Absolute: ${i.rank_absolute}, Visibility: ${visibility}`;\n    })\n    .join('\\n'); // or '<br>' if you want HTML formatting\n\n  // =========================================\n  // 2️⃣ Detect blockers above fold (including partial)\n  // =========================================\n  const hasVisibleBlocker = serpItems.some(i => {\n    const y = i.rectangle?.y ?? 9999;\n    const height = i.rectangle?.height ?? 0;\n    const bottomEdge = y + height;\n    const isPartiallyOrFullyAboveFold = y < Y_THRESHOLD; // ✅ counts partial visibility\n    return BLOCKERS.includes(i.type) && isPartiallyOrFullyAboveFold;\n  });\n\n  // =========================================\n  // 3️⃣ Return structured output\n  // =========================================\n  return {\n    keyword,\n    serp_summary: serpSummary,\n    \"Has Map/Paid Results Above the Fold?\": hasVisibleBlocker ? 'Yes' : 'No'\n  };\n});\n\n// =========================================\n// RETURN FINAL OUTPUT\n// =========================================\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
