    {
      "parameters": {
        "jsCode": "// Verwacht GA4 response met rows[0].metricValues\nconst client = $json;            // bevat client_id + year_month uit je eerdere Function\nconst resp = items[0].json;\nconst row = resp.rows?.[0];\n\nreturn [{\n  json: {\n    year_month: client.year_month,      // \"YYYY-MM\" uit je date Function\n    client_id: client.client_id,\n    sessions: Number(row?.metricValues?.[0]?.value || 0),\n    conversions: Number(row?.metricValues?.[1]?.value || 0)\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2416,
        2608
      ],
      "id": "871059ec-5524-42bf-81f0-f03aaf68976a",
      "name": "Parse GA4 Data"
