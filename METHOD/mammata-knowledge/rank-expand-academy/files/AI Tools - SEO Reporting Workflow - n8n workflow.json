    {
      "parameters": {
        "method": "POST",
        "url": "=https://www.googleapis.com/webmasters/v3/sites/{{ $json['GSC site_url'] }}/searchAnalytics/query",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"startDate\": \"{{ $json.lastMonthStart }}\",\n  \"endDate\": \"{{ $json.lastMonthEnd }}\",\n  \"dimensions\": [\"page\",\"query\"],\n  \"searchType\": \"web\",\n  \"rowLimit\": 25000,\n  \"startRow\": 0,\n  \"aggregationType\": \"auto\",\n  \"dimensionFilterGroups\": []\n}",
        "options": {
          "allowUnauthorizedCerts": false
        }
      },
      "id": "c856f5ee-af41-48b2-bc66-8ea9db667aa0",
      "name": "Fetch GSC Queries",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1984,
        3360
      ]
    },
    {
      "parameters": {
        "jsCode": "// ---- CONFIG ---------------------------------------------------------------\nconst CFG = {\n  forceHttps: true,\n  dropHash: true,\n  stripParams: true,\n  keepParamsWhitelist: [],   // e.g. ['page']\n  collapseWww: true,\n  forceTrailingSlash: true,\n  lowercaseHost: true,\n  lowercasePath: false,\n\n  minImpressions: 0,         // e.g. 10\n  minClicks: 0,              // e.g. 1\n\n  dedupeMode: 'sum',         // 'sum' or 'max'\n  roundCTR: 6,\n  roundPosition: 4,\n};\n// --------------------------------------------------------------------------\n\nfunction normalizeUrl(u) {\n  if (!u) return '';\n  let url;\n  try { url = new URL(u); }\n  catch { try { url = new URL(u, 'https://x.invalid'); } catch { return (u||'').split('?')[0]; } }\n\n  if (CFG.forceHttps) url.protocol = 'https:';\n\n  let host = CFG.lowercaseHost ? url.host.toLowerCase() : url.host;\n  if (CFG.collapseWww && host.startsWith('www.')) host = host.slice(4);\n\n  let path = url.pathname || '/';\n  if (CFG.lowercasePath) path = path.toLowerCase();\n  path = path.replace(/\\/index\\.(html?|php)$/i, '/').replace(/\\/{2,}/g, '/');\n  if (CFG.forceTrailingSlash) {\n    if (path !== '/' && !path.endsWith('/')) path += '/';\n  } else if (path !== '/' && path.endsWith('/')) {\n    path = path.slice(0, -1);\n  }\n\n  if (CFG.stripParams) {\n    if (CFG.keepParamsWhitelist.length) {\n      const kept = [];\n      for (const [k,v] of url.searchParams.entries()) if (CFG.keepParamsWhitelist.includes(k)) kept.push(`${k}=${v}`);\n      url.search = kept.length ? `?${kept.join('&')}` : '';\n    } else {\n      url.search = '';\n    }\n  }\n  if (CFG.dropHash) url.hash = '';\n\n  return `https://${host}${path}${url.search}`;\n}\n\nfunction roundNum(x, d) {\n  if (typeof x !== 'number') x = Number(x || 0);\n  return Number.isFinite(x) ? Number(x.toFixed(d)) : 0;\n}\n\nfunction passFilters(rec) {\n  if ((rec.Impressions || 0) < CFG.minImpressions) return false;\n  if ((rec.Clicks || 0) < CFG.minClicks) return false;\n  return true;\n}\n\nfunction dedupeRows(rows, mode = 'sum') {\n  const map = new Map();\n  for (const r of rows) {\n    const k = r.Key;\n    const prev = map.get(k);\n    if (!prev) { map.set(k, r); continue; }\n\n    if (mode === 'max') {\n      map.set(k, (r.Impressions||0) > (prev.Impressions||0) ? r : prev);\n    } else {\n      prev.Clicks = (prev.Clicks||0) + (r.Clicks||0);\n      prev.Impressions = (prev.Impressions||0) + (r.Impressions||0);\n      prev.CTR = prev.Impressions ? prev.Clicks / prev.Impressions : 0;\n      const wImp = (prev._wImp||0) + (r.Impressions||0);\n      const wPos = (prev.Position||0) * (prev._wImp||0) + (r.Position||0) * (r.Impressions||0);\n      prev.Position = wImp ? (wPos / wImp) : 0;\n      prev._wImp = wImp;\n      map.set(k, prev);\n    }\n  }\n  const out = [];\n  for (const v of map.values()) {\n    delete v._wImp;\n    v.CTR = roundNum(v.CTR, CFG.roundCTR);\n    v.Position = roundNum(v.Position, CFG.roundPosition);\n    out.push(v);\n  }\n  return out;\n}\n\nfunction getPeriod() {\n  const s = $json.startDate || '';\n  const e = $json.endDate || '';\n  return (s && e) ? `${s}:${e}` : '';\n}\n\nconst period = getPeriod() || new Date().toISOString().slice(0,10);\nconst out = [];\n\nfor (const i of items) {\n  const rows = i.json.rows || [];\n  for (const r of rows) {\n    const pageRaw  = (r.keys && r.keys[0]) || '';\n    const query    = (r.keys && r.keys[1]) || '';\n    const page = normalizeUrl(pageRaw);\n\n    const rec = {\n      Period: period,\n      Page: page,\n      Query: query,\n      Clicks: r.clicks || 0,\n      Impressions: r.impressions || 0,\n      CTR: roundNum(r.ctr || 0, CFG.roundCTR),\n      Position: roundNum(r.position || 0, CFG.roundPosition),\n      Key: `${period}|${page}|${query}`\n    };\n\n    if (passFilters(rec)) out.push(rec);\n  }\n}\n\nconst deduped = dedupeRows(out, CFG.dedupeMode);\nreturn deduped.map(json => ({ json }));"
