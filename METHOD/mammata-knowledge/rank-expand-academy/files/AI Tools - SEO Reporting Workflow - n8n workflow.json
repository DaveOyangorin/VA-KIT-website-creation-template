        "jsCode": "// Add lastMonthStart / lastMonthEnd (YYYY-MM-DD) and year_month (YYYY-MM)\nconst now = new Date();\nconst firstOfThisMonth = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1));\nconst lastMonthEndDate = new Date(firstOfThisMonth - 1);\nconst lastMonthStartDate = new Date(Date.UTC(lastMonthEndDate.getUTCFullYear(), lastMonthEndDate.getUTCMonth(), 1));\n\nfunction fmt(d){ return d.toISOString().slice(0,10); }\n\nreturn {\n  ...$json, // use current item\n  lastMonthStart: fmt(lastMonthStartDate),\n  lastMonthEnd: fmt(lastMonthEndDate),\n  current_year_month: fmt(lastMonthStartDate).slice(0,7),\n  sheet_id: $('Set Sheet ID').first().json.id_sheet\n};\n"
