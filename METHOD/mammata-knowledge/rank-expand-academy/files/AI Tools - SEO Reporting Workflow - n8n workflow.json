      "parameters": {
        "jsCode": "// -------------------------------------------------------\n// Combine \"Get Last Month Field\" (client info) + GSC API data\n// -------------------------------------------------------\n\n// From \"Get Last Month Field\" node\nconst clientData = $json;\n\n// From current node input (GSC API response JSON)\nconst gscResponse = $json;\n\n// Safely extract the GSC metrics\nconst row = gscResponse?.rows?.[0] || {};\nconst clicks = Number(row.clicks || 0);\nconst impressions = Number(row.impressions || 0);\nconst ctr = impressions > 0 ? (clicks / impressions) : 0;\nconst position = Number(row.position || 0);\nconst indexed_pages = 0; // placeholder\n\n// Return combined enriched object\nreturn {\n  client_id: clientData.client_id,\n  name: clientData.name,\n  year_month: clientData.year_month,\n  clicks,\n  impressions,\n  ctr,\n  position,\n  indexed_pages\n};\n"
