        "url": "=https://analyticsdata.googleapis.com/v1beta/properties/{{ $json['GA4 property_id'] }}:runReport",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"dateRanges\": [\n    { \"startDate\": \"{{$json.lastMonthStart}}\", \"endDate\": \"{{$json.lastMonthEnd}}\" }\n  ],\n  \"dimensions\": [\n    { \"name\": \"sessionDefaultChannelGroup\" }\n  ],\n  \"dimensionFilter\": {\n    \"filter\": {\n      \"fieldName\": \"sessionDefaultChannelGroup\",\n      \"stringFilter\": { \"matchType\": \"EXACT\", \"value\": \"Organic Search\" }\n    }\n  },\n  \"metrics\": [\n    { \"name\": \"sessions\" },\n    { \"name\": \"conversions\" }\n  ]\n}",
        "options": {
          "allowUnauthorizedCerts": false
        }
