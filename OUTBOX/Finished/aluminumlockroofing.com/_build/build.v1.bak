    return f'''<a class="skip" href="#main">Skip to content</a>
<div class="topbar"><div class="wrap"><span>Interlocking aluminum shingle roofing &middot; Salt Lake City, Utah</span><span>Call <a href="tel:{S["tel"]}">{S["phone"]}</a> &middot; <a href="mailto:{S["email"]}">{S["email"]}</a></span></div></div>
<header class="site-header"><div class="wrap">
<a class="brand" href="@/" aria-label="{S["name"]} home">{img("aluminum-lock-roofing-logo-light", "Aluminum Lock Roofing Inc.", lazy=False)}</a>
<nav class="nav" aria-label="Main"><ul>
<li><a href="@/services/">Services</a></li>
<li><a href="@/about-us/">About</a></li>
<li><a href="@/faq/">FAQ</a></li>
<li><a href="@/blog/">Blog</a></li>
<li><a href="@/contact-us/">Contact</a></li>
</ul></nav>
<div class="head-cta"><a class="head-phone" href="tel:{S["tel"]}"><small>Talk to us</small><strong>{S["phone"]}</strong></a><a class="btn" href="@/contact-us/">Start Your Project {ARROW}</a></div>
<details class="menu"><summary aria-label="Open menu"><span></span></summary><div class="menu-panel">
<a href="@/">Home</a><a href="@/services/">Services</a><a href="@/about-us/">About</a><a href="@/faq/">FAQ</a><a href="@/blog/">Blog</a><a href="@/contact-us/">Contact</a>
<a class="btn" href="@/contact-us/">Start Your Project {ARROW}</a></div></details>
</div></header>'''


def footer():
    fb = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4h-3c-2.8 0-4.5 1.8-4.5 4.6V11H7v4h2.5v9h4v-9H17l.5-4h-4V8.8c0-.5.3-.8.5-.8z"/></svg>'
    return f'''<footer class="site-footer"><div class="wrap foot">
<div>{img("aluminum-lock-roofing-logo-light", "Aluminum Lock Roofing logo", cls="logo")}
<p style="margin-top:18px;max-width:34ch">We manufacture, supply and install interlocking aluminum shingle roofs, and sell aluminum roofing materials to roofers.</p>
<div class="socials"><a href="{S["fb"]}" rel="noopener" aria-label="Facebook">{fb}</a></div></div>
<div><h3>Roofing</h3><ul><li><a href="@/services/">Aluminum shingle installation</a></li><li><a href="@/services/#materials">Materials for roofers</a></li><li><a href="@/faq/">Roofing FAQ</a></li><li><a href="@/blog/">Blog</a></li></ul></div>
<div><h3>Company</h3><ul><li><a href="@/about-us/">About us</a></li><li><a href="@/contact-us/">Contact</a></li><li><a href="@/privacy-policy/">Privacy policy</a></li></ul></div>
<div><h3>Contact</h3><p style="margin:0 0 6px"><strong style="color:#fff">{S["name"]}</strong><br>{S["city"]}, Utah</p>
<p style="margin:10px 0 4px"><a class="fphone" href="tel:{S["tel"]}">{S["phone"]}</a></p>
<p style="margin:0"><a href="mailto:{S["email"]}">{S["email"]}</a></p></div>
</div><div class="wrap fbottom"><span>&copy; 2026 Aluminum Lock Roofing. All rights reserved.</span><span><a href="@/privacy-policy/">Privacy Policy</a> &middot; <a href="@/sitemap.xml">Sitemap</a></span></div></footer>
<div class="callbar"><a href="tel:{S["tel"]}">{PHONE} Call Now</a><a href="@/contact-us/">Get Started</a></div>'''


def cta(title="Planning an aluminum shingle roof?", text="Tell us your project location, your current roof type and what you want to accomplish. We'll talk through installation or materials."):
    return f'''<section class="cta">{img("copper-aluminum-shingle-a-frame", "A-frame home with a copper-colored aluminum shingle roof")}
<div class="wrap"><div class="reveal"><p class="label">Start with your project</p><h2>{title}</h2><p class="lede" style="margin-top:14px">{text}</p></div>
<div class="reveal"><a class="phone" href="tel:{S["tel"]}">{S["phone"]}</a><div class="btn-row" style="margin-top:22px"><a class="btn" href="@/contact-us/">Contact Us {ARROW}</a><a class="btn ghost" href="@/faq/">Read the FAQ</a></div></div></div></section>'''


def side(links, promise=True):
    lis = "".join(f'<li><a href="@/{p}">{l}</a></li>' for l, p in links)
    return f'''<aside class="side"><div class="card-cta"><p class="label light">Talk to us</p><h3>Discuss your roof or materials</h3>
<p>Include your project location, your current roof type, and whether you need installation or materials.</p><a class="phone" href="tel:{S["tel"]}">{S["phone"]}</a>
<a class="btn" href="@/contact-us/">Contact Us {ARROW}</a></div>
<div class="card-list"><h3>Related</h3><ul>{lis}</ul></div></aside>'''


def phero(trail, h1, lede, image, alt, label, extra=""):
    lede_html = f'<p class="lede">{lede}</p>' if lede else ""
    return f'''<section class="phero">{img(image, alt, priority=True)}<div class="wrap">{crumbs_html(trail)}
<p class="label light">{label}</p><h1>{h1}</h1>{lede_html}{extra}
<div class="btn-row" style="margin-top:26px"><a class="btn" href="tel:{S["tel"]}">{PHONE} {S["phone"]}</a><a class="btn ghost" href="@/contact-us/">Contact Us {ARROW}</a></div></div></section>'''


def quote_form(title="Tell us about your project"):
    return f'''<form class="form" method="post" action="">
<h3>{title}</h3>
<div class="row"><label for="f-name">Name *<input id="f-name" name="name" autocomplete="name" required></label><label for="f-phone">Phone *<input id="f-phone" type="tel" name="phone" autocomplete="tel" required></label></div>
<div class="row"><label for="f-email">Email *<input id="f-email" type="email" name="email" autocomplete="email" required></label><label for="f-loc">Project location (city) *<input id="f-loc" name="location" autocomplete="address-level2" required></label></div>
<div class="row"><label for="f-roof">Current roof type<input id="f-roof" name="roof" placeholder="e.g. asphalt shingles, metal, wood shake"></label>
<label for="f-need">I need<select id="f-need" name="need"><option value="">Choose one</option><option>Roof installation</option><option>Roofing materials (I'm a roofer)</option><option>Not sure yet</option></select></label></div>
<label for="f-msg">What would you like to accomplish? (For materials: products and approximate quantities)<textarea id="f-msg" name="message"></textarea></label>
<button class="btn navy" type="submit">Send {ARROW}</button>
<p class="note">* Required. We'll reply by phone or email.</p></form>'''


def head(page):
    url = U + page["path"]
    graph = [biz(page.get("full_biz", True)),
             {"@type": "WebSite", "@id": U + "#website", "url": U, "name": S["name"], "publisher": {"@id": BIZ_ID}}] + page.get("schema", [])
    ld = json.dumps({"@context": "https://schema.org", "@graph": graph}, ensure_ascii=False, indent=1).replace("</", "<\\/")
    og = U + "assets/img/" + page.get("og", "green-aluminum-shingle-log-home") + ".webp"
    t = html.escape(page["title"], quote=False); m = html.escape(page["meta"], quote=True)
    canon = f'<link rel="canonical" href="{page["canonical"]}">' if page.get("canonical") else ""
    return f'''<!doctype html>
<html lang="en-US">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{t}</title>
<meta name="description" content="{m}">
<meta name="robots" content="{page.get("robots", "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1")}">
{canon}
<meta property="og:type" content="{page.get("ogtype", "website")}">
<meta property="og:site_name" content="Aluminum Lock Roofing">
<meta property="og:title" content="{t}">
<meta property="og:description" content="{m}">
<meta property="og:url" content="{url}">
<meta property="og:image" content="{og}">
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#141516">
<link rel="icon" type="image/png" href="@img/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chivo:wght@600;700;800;900&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="@root/assets/style.css">
<script>document.documentElement.classList.add('js')</script>
@@TRACK_HEAD@@
<script type="application/ld+json">
{ld}
</script>
</head>'''


def resolve(doc, page, mode, known, redirects):
    depth = page["path"].count("/") if not page["path"].endswith(".html") else page["path"].count("/")
    pre = "../" * depth

    def link(m):
        p = m.group(1)
        frag = ""
        if "#" in p: p, frag = p.split("#", 1); frag = "#" + frag
        if p.endswith((".xml", ".txt", ".html")): return pre + p + frag
        p = redirects.get(p, p)
        if p not in known:
            return U + p + frag  # page that is not part of this build: point at the live URL
        if mode == "preview": return pre + (p or "home/") + "index.html" + frag  # preview: site home lives in home/, the review page is the root
        return (pre + p or "./") + frag
    doc = re.sub(r'@/([A-Za-z0-9\-/\._#]*)', link, doc)
    return doc.replace("@img/", pre + "assets/img/").replace("@root/", pre)


def render(page, mode, known, redirects):
    draft = '<div class="draft-strip">DRAFT PREVIEW for aluminumlockroofing.com &middot; made by Novarte AI for review &middot; not the live site</div>\n' if mode == "preview" else ""
    doc = (head(page) + "\n<body>\n" + ("@@TRACK_BODY@@\n" if mode == "site" else "") + draft + header() +
           '\n<main id="main">\n' + page["body"] + "\n</main>\n" + footer() + '\n<script src="@root/assets/site.js" defer></script>\n</body>\n</html>\n')
    doc = resolve(doc, page, mode, known, redirects)
    if mode == "site":
        doc = doc.replace("@@TRACK_HEAD@@", TRACK_HEAD.strip()).replace("@@TRACK_BODY@@", TRACK_BODY.strip())
    else:
        depth = page["path"].count("/")
        pre = "../" * depth
        doc = doc.replace("@@TRACK_HEAD@@\n", "")
        css = open(os.path.join(HERE, "style.css"), encoding="utf-8").read()
        js = open(os.path.join(HERE, "site.js"), encoding="utf-8").read()
        doc = doc.replace(f'<link rel="stylesheet" href="{pre}assets/style.css">', "<style>\n" + css + "\n</style>")
        doc = doc.replace(f'<script src="{pre}assets/site.js" defer></script>', "<script>\n" + js + "\n</script>")
        doc = re.sub(r'<form class="form"[^>]*>', '<form class="form" onsubmit="return false">', doc)
        doc = re.sub(r'<button class="btn" type="submit">[^<]*', '<button class="btn" type="button" disabled>Form is off in this preview ', doc)
        if page["path"] == "":
            doc = re.sub(r'(?s)^<!doctype html>\s*<html[^>]*>\s*<head>\s*', '', doc)
            doc = doc.replace('<meta charset="utf-8">\n', '').replace('<meta name="viewport" content="width=device-width, initial-scale=1">\n', '')
            doc = re.sub(r'<title>.*?</title>', '<title>Aluminum Lock Redesign</title>', doc, count=1)
            doc = re.sub(r'</head>\s*<body>\s*', '\n', doc)
            doc = re.sub(r'\s*</body>\s*</html>\s*$', '\n', doc)
    return doc


def main(ex_path, site_dir, prev_dir):
    from pages import make_pages
    pages, redirects = make_pages(json.load(open(ex_path, encoding="utf-8")))
    known = {p["path"] for p in pages}
    for mode, root in (("site", site_dir), ("preview", prev_dir)):
        os.makedirs(os.path.join(root, "assets"), exist_ok=True)
        if mode == "site":
            shutil.copy(os.path.join(HERE, "style.css"), os.path.join(root, "assets", "style.css"))
            shutil.copy(os.path.join(HERE, "site.js"), os.path.join(root, "assets", "site.js"))
        else:
            shutil.copytree(os.path.join(site_dir, "assets", "img"), os.path.join(root, "assets", "img"), dirs_exist_ok=True)
        for pg in pages:
            if mode == "preview" and pg["path"] == "": pg = dict(pg, path="home/")
            out = os.path.join(root, "404.html") if pg["path"] == "404.html" else os.path.join(root, pg["path"], "index.html")
            os.makedirs(os.path.dirname(out), exist_ok=True)
            open(out, "w", encoding="utf-8", newline="\n").write(render(pg, mode, known, redirects))
        sm = ['<?xml version="1.0" encoding="UTF-8"?>', '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">']
        for pg in pages:
            if pg.get("sitemap", True):
                sm.append(f'  <url><loc>{pg["canonical"]}</loc><lastmod>{pg.get("modified") or TODAY}</lastmod></url>')
        sm.append("</urlset>")
        open(os.path.join(root, "sitemap.xml"), "w", encoding="utf-8", newline="\n").write("\n".join(sm) + "\n")
        shutil.copy(os.path.join(HERE, "robots.txt"), os.path.join(root, "robots.txt"))
    json.dump(redirects, open(os.path.join(HERE, "redirects.json"), "w"), indent=1)
    print("built", len(pages), "pages;", len(redirects), "redirects kept out")


if __name__ == "__main__":
    main(*sys.argv[1:4])
