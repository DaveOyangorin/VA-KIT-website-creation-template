/* Aluminum Lock Roofing: Salt Lake City, Utah.
   Layout idea: "the roof archive". Decades of real aluminum shingle roofs, shown like print
   snapshots with typed captions; brushed-aluminum bands; the eight real shingle colors as chips.
   Near-black + aluminum gray, with a copper-orange accent close to the brand's #FF6600. */
:root {
  --char: #141516;
  --char-2: #26292d;
  --char-3: #393d43;
  --butter: #ec7a36;
  --gold: #ad7c55;
  --gold-ink: #9a4510;
  --concrete: #eef0f2;
  --paper: #ffffff;
  --ink: #141517;
  --steel: #5c6068;
  --line: #d5d9de;
  --line-dark: rgba(255,255,255,.14);
  --display: "Chivo", "Arial", sans-serif;
  --body: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
  --mono: ui-monospace, "Cascadia Mono", "Consolas", monospace;
  --wrap: 1220px;
  --gutter: clamp(16px, 4vw, 40px);
  --r: 6px;
  --shadow: 0 30px 60px -30px rgba(20,21,23,.55);
  color-scheme: light;
}
*,*::before,*::after { box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--concrete); color: var(--ink); font: 400 17px/1.65 var(--body); overflow-x: hidden; }
main { overflow-x: clip; }
img { max-width: 100%; height: auto; display: block; }
a { color: inherit; }
p { margin: 0 0 1.1em; }
h1,h2,h3,h4,h5 { font-family: var(--display);  font-weight: 800; line-height: 1.02; letter-spacing: -.025em; margin: 0 0 .5em; text-wrap: balance; }
h1 { font-size: clamp(2.5rem, 6.4vw, 5.4rem); }
h2 { font-size: clamp(1.9rem, 4vw, 3.2rem); }
h3 { font-size: clamp(1.2rem, 2vw, 1.5rem); font-weight: 700; letter-spacing: -.015em; }
h4, h5 { font-size: 1.1rem; font-weight: 700; }
.wrap { width: min(100% - 2*var(--gutter), var(--wrap)); margin-inline: auto; }
.skip { position: absolute; left: -999px; top: 0; background: var(--butter); color: var(--char); padding: 12px 18px; z-index: 100; font-weight: 700; }
.skip:focus { left: 12px; top: 12px; }
:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }

.label { display: inline-flex; align-items: center; gap: 10px; font: 700 .78rem/1 var(--body); letter-spacing: .16em; text-transform: uppercase; color: var(--gold-ink); margin-bottom: 18px; }
.label::before { content: ""; width: 10px; height: 10px; background: var(--butter); border: 2px solid var(--char); transform: rotate(45deg); }
.dark .label, .label.light { color: var(--butter); }
.dark .label::before, .label.light::before { border-color: var(--butter); background: transparent; }
.lede { font-size: clamp(1.08rem, 1.5vw, 1.24rem); color: var(--steel); max-width: 60ch; }
.dark .lede, .hero .lede, .phero .lede, .cta .lede, .band .lede { color: rgba(255,255,255,.82); }
em.hand { font-style: normal; color: var(--gold-ink); }

.btn { --bg: var(--butter); --fg: var(--char); display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 54px; padding: 0 26px; border-radius: 4px; border: 2px solid var(--bg); background: var(--bg); color: var(--fg); text-decoration: none; font: 700 1rem/1 var(--body); transition: background .25s, border-color .25s, color .25s, transform .2s; }
.btn svg { width: 18px; height: 18px; transition: transform .25s; flex-shrink: 0; }
.btn:hover { background: #fff; border-color: #fff; }
.btn:hover svg { transform: translateX(4px); }
.btn:active { transform: translateY(1px); }
.btn.ghost { --bg: transparent; --fg: #fff; border-color: rgba(255,255,255,.55); }
.btn.ghost:hover { background: #fff; color: var(--char); border-color: #fff; }
.btn.navy { --bg: var(--char); --fg: #fff; }
.btn.navy:hover { background: var(--char-3); border-color: var(--char-3); }
.sec:not(.dark) .btn:not(.navy):not(.ghost):hover { background: var(--char); border-color: var(--char); color: #fff; }
.btn-row { display: flex; flex-wrap: wrap; gap: 12px; }
.tlink { display: inline-flex; align-items: center; gap: 10px; padding: 12px 0; text-decoration: none; font-weight: 700; color: var(--ink); border-bottom: 2px solid var(--butter); transition: gap .25s, border-color .25s; }
.tlink svg { width: 16px; height: 16px; }
.tlink:hover { gap: 16px; border-color: var(--char); }
.dark .tlink { color: #fff; }

/* header */
.topbar { background: var(--butter); color: var(--char); font-size: .86rem; font-weight: 600; }
.topbar .wrap { display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap; padding: 7px 0; }
.topbar a { color: var(--char); font-weight: 800; text-decoration: none; }
.site-header { position: sticky; top: 0; z-index: 50; background: rgba(23,24,26,.96); backdrop-filter: blur(10px); color: #fff; transition: box-shadow .3s; }
.site-header.scrolled { box-shadow: 0 14px 30px -18px rgba(0,0,0,.6); }
.site-header .wrap { display: flex; align-items: center; justify-content: space-between; gap: 18px; min-height: 78px; }
.brand img { width: 170px; height: auto; }
.nav { display: none; }
.nav > ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 2px; }
.nav a, .nav summary { display: block; padding: 11px 13px; text-decoration: none; cursor: pointer; list-style: none; font-weight: 600; font-size: .97rem; color: rgba(255,255,255,.88); border-radius: 4px; }
.nav summary::-webkit-details-marker { display: none; }
.nav summary::after { content: ""; display: inline-block; width: 6px; height: 6px; margin-left: 8px; border-right: 2px solid var(--butter); border-bottom: 2px solid var(--butter); transform: translateY(-3px) rotate(45deg); }
.nav > ul > li > a:hover, .nav summary:hover { background: rgba(255,255,255,.08); color: #fff; }
.nav details { position: relative; }
.nav .drop { position: absolute; top: calc(100% + 8px); left: 0; background: #fff; color: var(--ink); border-radius: var(--r); box-shadow: var(--shadow); padding: 14px; display: grid; min-width: 260px; }
.nav .drop.wide { grid-template-columns: repeat(2, minmax(220px, 1fr)); min-width: 520px; }
.nav .drop h5 { font: 700 .72rem/1 var(--body); letter-spacing: .16em; text-transform: uppercase; color: var(--steel); margin: 8px 10px; }
.nav .drop a { padding: 10px; font-weight: 500; font-size: .95rem; color: var(--ink); border-radius: 8px; }
.nav .drop a:hover { background: var(--concrete); }
.head-cta { display: none; align-items: center; gap: 16px; }
.head-phone { text-decoration: none; text-align: right; line-height: 1.15; }
.head-phone small { display: block; font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.6); }
.head-phone strong { font: 800 1.2rem/1 var(--display);  color: #fff; }
.menu { position: relative; }
.menu > summary { list-style: none; cursor: pointer; width: 52px; height: 52px; display: grid; place-items: center; border: 1px solid var(--line-dark); border-radius: 4px; }
.menu > summary::-webkit-details-marker { display: none; }
.menu > summary span, .menu > summary span::before, .menu > summary span::after { display: block; width: 20px; height: 2px; background: #fff; position: relative; transition: transform .3s, background .3s; }
.menu > summary span::before, .menu > summary span::after { content: ""; position: absolute; left: 0; }
.menu > summary span::before { top: -6px; } .menu > summary span::after { top: 6px; }
.menu[open] > summary span { background: transparent; }
.menu[open] > summary span::before { transform: translateY(6px) rotate(45deg); }
.menu[open] > summary span::after { transform: translateY(-6px) rotate(-45deg); }
.menu-panel { position: fixed; inset: 112px 0 0 0; background: var(--char); color: #fff; padding: 12px var(--gutter) 120px; overflow-y: auto; }
.menu-panel a { display: block; padding: 14px 0; border-bottom: 1px solid var(--line-dark); text-decoration: none; font: 800 1.35rem/1.2 var(--display);  }
.menu-panel .sub a { font: 500 1rem/1.3 var(--body); padding: 11px 0 11px 16px; color: rgba(255,255,255,.8); }
.menu-panel .btn { margin-top: 22px; width: 100%; }

/* hero: aerial photo under a faint survey grid */
.hero { position: relative; color: #fff; background: var(--char); isolation: isolate; overflow: hidden; }
.hero > img { position: absolute; inset: 0; width: 100%; height: 115%; object-fit: cover; z-index: -3; will-change: transform; }
.hero::before { content: ""; position: absolute; inset: 0; z-index: -2; background: linear-gradient(100deg, rgba(23,24,26,.92) 0%, rgba(23,24,26,.7) 45%, rgba(23,24,26,.15) 85%); }
.hero::after { content: ""; position: absolute; inset: 0; z-index: -1; opacity: .5;
  background-image: linear-gradient(rgba(214,219,225,.16) 1px, transparent 1px), linear-gradient(90deg, rgba(214,219,225,.16) 1px, transparent 1px);
  background-size: 88px 88px; mask-image: linear-gradient(90deg, transparent 30%, #000 75%); -webkit-mask-image: linear-gradient(90deg, transparent 30%, #000 75%); }
.hero .wrap { padding: clamp(60px, 9vw, 130px) 0 clamp(56px, 8vw, 110px); position: relative; }
.hero h1 { font-size: clamp(2.7rem, 7.4vw, 6.2rem); line-height: .95; max-width: 12ch; margin-bottom: 24px; }
.hero h1 span { color: var(--butter); }
.hero .lede { margin-bottom: 28px; }
.rating { display: flex; align-items: center; gap: 12px; margin-top: 22px; font-size: .95rem; color: rgba(255,255,255,.85); }
.rating .stars { color: var(--butter); letter-spacing: .12em; }
.ticket { position: absolute; right: 0; bottom: clamp(40px, 6vw, 80px); width: 300px; background: var(--butter); color: var(--char); border-radius: var(--r); padding: 22px 24px; box-shadow: var(--shadow); display: none; }
.ticket::before, .ticket::after { content: ""; position: absolute; top: 50%; width: 22px; height: 22px; margin-top: -11px; border-radius: 50%; background: var(--char); }
.ticket::before { left: -11px; } .ticket::after { right: -11px; }
.ticket small { display: block; font: 700 .72rem/1 var(--body); letter-spacing: .16em; text-transform: uppercase; margin-bottom: 8px; }
.ticket b { display: block; font: 800 1.6rem/1.05 var(--display);  letter-spacing: -.02em; }
.ticket p { margin: 10px 0 0; font-size: .88rem; line-height: 1.45; border-top: 2px dashed rgba(23,24,26,.35); padding-top: 10px; }
.photo-tag { position: absolute; left: var(--gutter); bottom: 16px; font-size: .74rem; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.65); }
.badges { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin-top: 34px; padding-top: 22px; border-top: 1px solid var(--line-dark); }
.badges img { height: 46px; width: auto; background: #fff; padding: 6px 10px; border-radius: 10px; }

/* number band */
.statband { background: var(--char); color: #fff; }
.statband .wrap { display: grid; grid-template-columns: repeat(2, 1fr); }
.stat { padding: 28px 18px 28px 0; border-right: 1px solid var(--line-dark); border-top: 1px solid var(--line-dark); }
.stat:nth-child(2n) { border-right: 0; padding-left: 18px; }
.stat b { display: block; font: 800 clamp(2.2rem, 5vw, 3.6rem)/1 var(--display);  letter-spacing: -.03em; color: var(--butter); white-space: nowrap; }
.stat b sup { font-size: .42em; color: #fff; vertical-align: top; margin-left: 3px; letter-spacing: 0; }
.stat span { display: block; margin-top: 8px; font-size: .92rem; color: rgba(255,255,255,.72); }

.sec { padding: clamp(64px, 9vw, 120px) 0; position: relative; }
.sec.tight { padding: clamp(46px, 6vw, 80px) 0; }
.sec.white { background: var(--paper); }
.sec.dark { background: var(--char); color: #fff; }
.sec.yellow { background: var(--butter); }
.head { display: grid; gap: 14px; margin-bottom: clamp(32px, 5vw, 56px); max-width: 780px; }
.head h2, .head p { margin: 0; }
.split { display: grid; gap: clamp(32px, 6vw, 80px); align-items: center; }
.split > *, .layout > * { min-width: 0; }

.pillars { display: grid; gap: 14px; }
.pillar { display: grid; grid-template-columns: 52px 1fr; gap: 16px; padding: 22px; background: var(--paper); border-radius: var(--r); border: 1px solid var(--line); }
.sec.white .pillar { background: var(--concrete); border-color: transparent; }
.pillar .ic { width: 52px; height: 52px; display: grid; place-items: center; background: var(--char); color: var(--butter); border-radius: 12px; }
.pillar .ic svg { width: 24px; height: 24px; }
.pillar h3 { margin: 0 0 4px; font-size: 1.15rem; }
.pillar p { margin: 0; color: var(--steel); font-size: .97rem; }

.stack { position: relative; padding-bottom: 14%; }
.stack img { border-radius: var(--r); box-shadow: var(--shadow); width: 100%; aspect-ratio: 4/3; object-fit: cover; }
.stack .b { position: absolute; width: 46%; right: -3%; bottom: 0; border: 6px solid var(--concrete); aspect-ratio: 1; }
.sec.white .stack .b { border-color: var(--paper); }
.stack .cap { position: absolute; left: 14px; top: 14px; background: var(--butter); color: var(--char); font-size: .74rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; padding: 7px 12px; border-radius: 4px; }

.steps { display: grid; gap: 14px; counter-reset: s; list-style: none; padding: 0; margin: 0; }
.steps li { counter-increment: s; position: relative; padding: 26px 24px 24px 84px; background: var(--char-2); border-radius: var(--r); }
.steps li::before { content: counter(s); position: absolute; left: 22px; top: 22px; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; background: var(--butter); color: var(--char); font: 800 1.2rem/1 var(--display); }
.steps h3 { margin-bottom: 6px; color: #fff; }
.steps p { margin: 0; color: rgba(255,255,255,.78); }

.props { display: grid; gap: 14px; }
.prop { position: relative; overflow: hidden; border-radius: var(--r); color: #fff; text-decoration: none; min-height: 300px; display: flex; flex-direction: column; justify-content: flex-end; isolation: isolate; background: var(--char); }
.prop img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 1s cubic-bezier(.2,.7,.2,1); }
.prop::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(23,24,26,0) 20%, rgba(23,24,26,.6) 55%, rgba(23,24,26,.95) 100%); }
.prop:hover img { transform: scale(1.06); }
.prop .in { padding: 26px; }
.prop h3 { margin-bottom: 6px; }
.prop p { margin: 0 0 12px; color: rgba(255,255,255,.85); font-size: .97rem; max-width: 46ch; }
.prop .go { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; background: var(--butter); color: var(--char); padding: 9px 16px; border-radius: 4px; font-size: .92rem; }
.prop .go svg { width: 15px; height: 15px; transition: transform .3s; }
.prop:hover .go svg { transform: translateX(4px); }

.projects { display: grid; grid-auto-flow: column; grid-auto-columns: 80%; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 10px; }
.projects figure { margin: 0; scroll-snap-align: start; position: relative; border-radius: var(--r); overflow: hidden; background: var(--char); }
.projects img { width: 100%; height: 300px; object-fit: cover; transition: transform .9s; }
.projects figure:hover img { transform: scale(1.04); }
.projects figcaption { position: absolute; left: 12px; bottom: 12px; color: var(--char); background: var(--butter); font-size: .78rem; font-weight: 700; padding: 6px 12px; border-radius: 4px; }

.band { position: relative; color: #fff; isolation: isolate; overflow: hidden; background: var(--char); }
.band > img { position: absolute; inset: -10% 0; width: 100%; height: 120%; object-fit: cover; z-index: -2; will-change: transform; }
.band::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(23,24,26,.95), rgba(23,24,26,.7) 55%, rgba(23,24,26,.25)); }
.band .wrap { padding: clamp(80px, 11vw, 150px) 0; }
.band .copy { max-width: 640px; }

.reviews-live { background: var(--char-2); color: #fff; border-radius: var(--r); padding: 34px; display: grid; gap: 10px; }
.reviews-live b { font: 800 clamp(2.4rem, 5vw, 3.4rem)/1 var(--display);  color: var(--butter); }
.reviews-live .stars { color: var(--butter); letter-spacing: .14em; font-size: 1.2rem; }
.quotes { display: grid; gap: 16px; }
.quote { margin: 0; background: var(--paper); border-radius: var(--r); padding: 26px; border: 1px solid var(--line); }
.quote .stars { color: var(--gold); letter-spacing: .14em; margin-bottom: 10px; }
.quote blockquote { margin: 0 0 14px; }
.quote blockquote p { margin: 0; }
.quote figcaption { font-weight: 700; }
.quote.big { background: var(--char); color: #fff; border: 0; }
.quote.big blockquote p { font: 600 clamp(1.2rem, 2vw, 1.5rem)/1.35 var(--display); }

.faq { display: grid; gap: 10px; }
.faq details { background: var(--paper); border-radius: var(--r); border: 1px solid var(--line); padding: 0 22px; }
.sec.white .faq details { background: var(--concrete); border-color: transparent; }
.faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 18px; padding: 20px 0; font: 700 1.08rem/1.3 var(--display);  letter-spacing: -.01em; }
.faq summary::-webkit-details-marker { display: none; }
.faq summary::after { content: "+"; flex-shrink: 0; width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; background: var(--butter); color: var(--char); font: 700 1.1rem/1 var(--body); transition: transform .3s; }
.faq details[open] summary::after { transform: rotate(45deg); }
.faq .a { padding: 0 0 20px; color: var(--steel); max-width: 72ch; }
.faq .a p:last-child { margin: 0; }

.cta { position: relative; color: var(--char); isolation: isolate; overflow: hidden; background: var(--butter); }
.cta > img { position: absolute; right: 0; top: 0; width: 46%; height: 100%; object-fit: cover; z-index: -1; clip-path: polygon(22% 0, 100% 0, 100% 100%, 0 100%); display: none; }
.cta .wrap { padding: clamp(64px, 9vw, 116px) 0; display: grid; gap: 26px; }
.cta h2 { font-size: clamp(2.2rem, 5.2vw, 4rem); margin: 0; max-width: 14ch; }
.cta .lede { color: rgba(23,24,26,.78); }
.cta .phone { font: 800 clamp(1.9rem, 4.4vw, 3rem)/1 var(--display);  color: var(--char); text-decoration: none; display: inline-block; border-bottom: 3px solid var(--char); padding-bottom: 4px; }
.cta .btn { --bg: var(--char); --fg: #fff; }
.cta .btn:hover { background: #fff; border-color: #fff; color: var(--char); }
.cta .btn.ghost { --bg: transparent; --fg: var(--char); border-color: var(--char); }
.cta .label { color: var(--char); }

.phero { position: relative; color: #fff; background: var(--char); isolation: isolate; overflow: hidden; }
.phero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -3; }
.phero::before { content: ""; position: absolute; inset: 0; z-index: -2; background: linear-gradient(100deg, rgba(23,24,26,.95) 0%, rgba(23,24,26,.82) 55%, rgba(23,24,26,.4) 100%); }
.phero::after { content: ""; position: absolute; inset: 0; z-index: -1; opacity: .45; background-image: linear-gradient(rgba(214,219,225,.14) 1px, transparent 1px), linear-gradient(90deg, rgba(214,219,225,.14) 1px, transparent 1px); background-size: 88px 88px; mask-image: linear-gradient(90deg, transparent 45%, #000 90%); -webkit-mask-image: linear-gradient(90deg, transparent 45%, #000 90%); }
.phero .wrap { padding: clamp(50px, 8vw, 104px) 0 clamp(54px, 8vw, 96px); }
.phero h1 { font-size: clamp(2.2rem, 5.2vw, 4.2rem); max-width: 18ch; margin-bottom: 18px; }
.crumbs { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 22px; padding: 0; font-size: .85rem; color: rgba(255,255,255,.7); }
.crumbs li + li::before { content: "/"; margin-right: 6px; color: var(--butter); }
.crumbs a { color: #fff; text-decoration: none; }
.crumbs a:hover { text-decoration: underline; }
.meta-line { display: flex; flex-wrap: wrap; gap: 6px 20px; margin-top: 16px; font-size: .9rem; color: rgba(255,255,255,.78); }

.layout { display: grid; gap: 48px; }
.prose { max-width: 74ch; }
.prose > :first-child { margin-top: 0; }
.prose h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); margin-top: 1.5em; }
.prose h3 { margin-top: 1.4em; }
.prose h4 { margin-top: 1.3em; }
.prose a { color: var(--ink); text-decoration-color: var(--gold); text-decoration-thickness: 2px; text-underline-offset: 3px; }
.prose a:hover { text-decoration-color: var(--char); }
.prose ul, .prose ol { padding-left: 1.25em; margin: 0 0 1.2em; }
.prose li { margin: .35em 0; }
.prose ul li::marker { color: var(--gold); }
.prose img { border-radius: var(--r); margin: 1.6em 0; }
.prose figure { margin: 1.8em 0; }
.prose figure img { margin: 0; width: 100%; }
.prose figcaption { font-size: .85rem; color: var(--steel); margin-top: 8px; }
.prose blockquote { margin: 1.6em 0; padding: 18px 22px; border-left: 4px solid var(--butter); background: var(--paper); border-radius: 0 var(--r) var(--r) 0; }
.answer { background: var(--paper); border-left: 5px solid var(--butter); padding: 20px 24px; margin: 0 0 1.8em; font-size: 1.08rem; border-radius: 0 var(--r) var(--r) 0; }
.tablebox { overflow-x: auto; margin: 0 0 1.6em; border-radius: var(--r); background: var(--paper); border: 1px solid var(--line); }
table { border-collapse: collapse; width: 100%; min-width: 540px; font-size: .95rem; }
th, td { text-align: left; padding: 13px 15px; border-bottom: 1px solid var(--line); vertical-align: top; }
th { background: var(--char); color: #fff; font-weight: 700; }
tr:last-child td { border-bottom: 0; }
.side { display: grid; gap: 16px; align-content: start; }
.card-cta { background: var(--char); color: #fff; padding: 26px; border-radius: var(--r); position: relative; overflow: hidden; }
.card-cta h3 { margin-bottom: 8px; }
.card-cta p { color: rgba(255,255,255,.8); font-size: .95rem; }
.card-cta .phone { display: block; font: 800 1.7rem/1 var(--display);  color: var(--butter); text-decoration: none; margin: 12px 0 14px; }
.card-cta .btn { width: 100%; }
.card-cta img { width: 130px; margin: 18px 0 0; background: #fff; border-radius: 10px; padding: 6px; }
.card-list { background: var(--paper); border-radius: var(--r); padding: 20px 22px; border: 1px solid var(--line); }
.card-list h3 { font-size: 1.02rem; margin-bottom: 6px; }
.card-list ul { list-style: none; margin: 0; padding: 0; }
.card-list a { display: flex; justify-content: space-between; gap: 10px; padding: 11px 0; border-bottom: 1px solid var(--line); text-decoration: none; font-weight: 500; font-size: .96rem; }
.card-list li:last-child a { border: 0; }
.card-list a::after { content: "→"; color: var(--gold); }
.card-list a:hover { color: var(--gold-ink); }

.prose .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 10px; margin: 1.4em 0 2em; }
.prose .gallery figure { margin: 0; position: relative; overflow: hidden; border-radius: 10px; background: var(--char); }
.prose .gallery img { margin: 0; width: 100%; aspect-ratio: 3/2; object-fit: cover; border-radius: 0; transition: transform .8s; }
.prose .gallery figure:hover img { transform: scale(1.05); }
.prose .gallery figcaption { position: absolute; left: 8px; bottom: 8px; margin: 0; padding: 4px 10px; font-size: .74rem; font-weight: 700; color: var(--char); background: var(--butter); border-radius: 4px; }

.grid { display: grid; gap: 14px; }
.linkcard { display: grid; gap: 6px; padding: 22px; background: var(--paper); border-radius: var(--r); border: 1px solid var(--line); text-decoration: none; transition: transform .25s, box-shadow .25s, border-color .25s; }
.linkcard:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: var(--butter); }
.linkcard b { font: 700 1.12rem/1.25 var(--display);  }
.linkcard span { color: var(--steel); font-size: .93rem; }
.postcard { display: grid; background: var(--paper); border-radius: var(--r); overflow: hidden; text-decoration: none; border: 1px solid var(--line); transition: box-shadow .3s, transform .3s; }
.postcard:hover { box-shadow: var(--shadow); transform: translateY(-3px); }
.postcard img { width: 100%; aspect-ratio: 16/9; object-fit: cover; }
.postcard .in { padding: 20px 22px 22px; }
.postcard small { color: var(--gold-ink); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; font-size: .72rem; }
.postcard b { display: block; font: 700 1.15rem/1.3 var(--display);  margin-top: 6px; }
.projects.mini { grid-auto-flow: row; grid-template-columns: 1fr 1fr; overflow: visible; }
.projects.mini figure:first-child { grid-row: auto; }
.projects.mini img, .projects.mini figure:first-child img { height: 220px; min-height: 0; }
.linkcard > img { width: 100%; aspect-ratio: 4/3; object-fit: cover; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chips a, .chips span { display: inline-block; padding: 10px 16px; border-radius: 4px; background: var(--paper); border: 1px solid var(--line); text-decoration: none; font-weight: 600; font-size: .92rem; }
.chips a:hover { background: var(--butter); border-color: var(--butter); }
.dark .chips a, .dark .chips span { background: transparent; color: #fff; border-color: var(--line-dark); }
.dark .chips a:hover { background: var(--butter); color: var(--char); }

.form { display: grid; gap: 16px; background: var(--paper); color: var(--ink); padding: clamp(22px, 4vw, 34px); border-radius: var(--r); box-shadow: var(--shadow); }
.form h3 { margin: 0; }
.form .row { display: grid; gap: 16px; }
.form label { display: grid; gap: 7px; font-weight: 600; font-size: .93rem; }
.form input, .form select, .form textarea { font: inherit; padding: 13px 15px; min-height: 52px; border: 1px solid #c4c7c0; border-radius: 10px; background: #fff; color: var(--ink); }
.form textarea { min-height: 130px; resize: vertical; }
.form input:focus, .form select:focus, .form textarea:focus { outline: 2px solid var(--gold); border-color: var(--gold); }
.form .note { font-size: .82rem; color: var(--steel); margin: 0; }

.site-footer { background: var(--char); color: rgba(255,255,255,.72); font-size: .94rem; }
.foot { padding: 64px 0 36px; display: grid; gap: 36px; }
.site-footer h3 { font: 700 .78rem/1 var(--body); letter-spacing: .16em; text-transform: uppercase; color: var(--butter); margin-bottom: 14px; }
.site-footer ul { list-style: none; margin: 0; padding: 0; }
.site-footer a { text-decoration: none; display: inline-block; padding: 5px 0; }
.site-footer a:hover { color: #fff; }
.site-footer address { font-style: normal; line-height: 1.7; }
.site-footer .fphone { font: 800 1.6rem/1 var(--display);  color: #fff; }
.site-footer .logo { width: 180px; }
.fbottom { border-top: 1px solid var(--line-dark); padding: 20px 0 96px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; font-size: .84rem; }
.socials { display: flex; gap: 10px; margin-top: 14px; flex-wrap: wrap; }
.socials a { width: 46px; height: 46px; display: grid; place-items: center; border: 1px solid var(--line-dark); border-radius: 50%; padding: 0; }
.socials a:hover { background: var(--butter); color: var(--char); border-color: var(--butter); }
.socials svg { width: 18px; height: 18px; fill: currentColor; }
.callbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; display: grid; grid-template-columns: 1fr 1fr; box-shadow: 0 -8px 24px rgba(0,0,0,.25); padding-bottom: env(safe-area-inset-bottom, 0px); background: var(--char); }
.callbar a { min-height: 58px; display: flex; align-items: center; justify-content: center; gap: 10px; text-decoration: none; font-weight: 700; }
.callbar a:first-child { background: var(--butter); color: var(--char); }
.callbar a:last-child { background: var(--char); color: #fff; }
.callbar svg { width: 18px; height: 18px; }
.draft-strip { background: #fff3c4; color: #3b2f00; font-size: .85rem; padding: 10px var(--gutter); text-align: center; border-bottom: 1px solid #e3cf7d; }

.js .reveal.pre { opacity: 0; transform: translateY(24px); }
.js .reveal { transition: opacity .8s cubic-bezier(.2,.7,.2,1), transform .8s cubic-bezier(.2,.7,.2,1); }

@media (min-width: 768px) {
  .statband .wrap { grid-template-columns: repeat(4, 1fr); }
  .stat, .stat:nth-child(2n) { border-top: 0; border-right: 1px solid var(--line-dark); padding: 34px 22px; }
  .stat:first-child { padding-left: 0; }
  .stat:last-child { border-right: 0; }
  .split { grid-template-columns: 1fr 1fr; }
  .split.rev > :first-child { order: 2; }
  .props { grid-template-columns: 1fr 1fr; }
  .projects { grid-auto-columns: 42%; }
  .quotes { grid-template-columns: 1fr 1fr; }
  .form .row { grid-template-columns: 1fr 1fr; }
  .grid { grid-template-columns: repeat(2, 1fr); }
  .pillars { grid-template-columns: 1fr 1fr; }
  .cta > img { display: block; }
  .cta .wrap > * { max-width: 52%; }
}
@media (min-width: 1024px) {
  .nav { display: block; }
  .head-cta { display: flex; }
  .menu { display: none; }
  .callbar { display: none; }
  .fbottom { padding-bottom: 20px; }
  .ticket { display: block; }
  .props { grid-template-columns: 1.3fr 1fr 1fr; grid-auto-rows: 320px; }
  .props .prop { min-height: 0; }
  .props .prop.f { grid-row: span 2; }
  .props .prop.w { grid-column: span 2; }
  .projects { grid-auto-flow: row; grid-template-columns: 2fr 1fr 1fr; overflow: visible; }
  .projects figure:first-child { grid-row: span 2; }
  .projects figure:first-child img { height: 100%; min-height: 612px; }
  .layout { grid-template-columns: minmax(0, 1fr) 330px; gap: 64px; }
  .side { position: sticky; top: 100px; }
  .foot { grid-template-columns: 1.3fr 1fr 1fr 1.2fr; }
  .grid { grid-template-columns: repeat(3, 1fr); }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { transition-duration: .001ms !important; animation-duration: .001ms !important; }
  .js .reveal.pre { opacity: 1; transform: none; }
  .hero > img, .band > img { transform: none !important; }
}

/* --- Aluminum Lock additions --- */
.label { font-family: var(--mono); letter-spacing: .12em; }
.brushed { background: linear-gradient(180deg, #e4e7ea, #cfd4d9 48%, #e9ecee 52%, #d6dade); background-image: repeating-linear-gradient(90deg, rgba(255,255,255,.18) 0 1px, rgba(0,0,0,.025) 1px 3px), linear-gradient(180deg, #e7eaed, #cdd2d7 50%, #e3e6e9); }
.swatches { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
.swatch { display: grid; gap: 8px; }
.swatch i { display: block; aspect-ratio: 5/4; border-radius: 4px; box-shadow: inset 0 0 0 1px rgba(0,0,0,.12), inset 0 -18px 30px -18px rgba(0,0,0,.35);
  background-image: repeating-linear-gradient(0deg, rgba(255,255,255,.08) 0 2px, transparent 2px 22px), repeating-linear-gradient(90deg, rgba(0,0,0,.10) 0 2px, transparent 2px 46px); }
.swatch b { font: 600 .9rem/1.2 var(--body); }
.swatch small { font: .74rem/1 var(--mono); color: var(--steel); text-transform: uppercase; letter-spacing: .08em; }
.snaps { display: grid; gap: 22px; }
.snap { margin: 0; background: #fff; padding: 10px 10px 14px; box-shadow: 0 18px 40px -22px rgba(20,21,22,.6); transform: rotate(var(--tilt, -1.2deg)); transition: transform .4s; }
.snap:hover { transform: rotate(0) translateY(-4px); }
.snap img { width: 100%; aspect-ratio: 4/3; object-fit: cover; }
.snap figcaption { font: .82rem/1.35 var(--mono); color: var(--steel); margin-top: 10px; }
.snap:nth-child(2n) { --tilt: 1.4deg; } .snap:nth-child(3n) { --tilt: -.6deg; }
.spec { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line-dark); }
.spec li { display: grid; grid-template-columns: 34px 1fr; gap: 12px; padding: 16px 0; border-bottom: 1px solid var(--line-dark); }
.spec li span { font: 700 .82rem/1.6 var(--mono); color: var(--butter); }
.spec b { display: block; color: #fff; font-family: var(--display); font-size: 1.08rem; }
.spec p { margin: 4px 0 0; color: rgba(255,255,255,.75); font-size: .95rem; }
.who { display: grid; gap: 14px; }
.who .linkcard b { font-size: 1.25rem; }
@media (min-width: 768px) { .swatches { grid-template-columns: repeat(4, 1fr); } .snaps { grid-template-columns: repeat(3, 1fr); } .who { grid-template-columns: 1fr 1fr; } }
